QMainWindow#visionWindow { background: #f3f5ef; }
QWidget#centralWidget { color: #193a40; font-family: "Microsoft YaHei", "Segoe UI"; font-size: 15px; }
QLabel#titleLabel { font-size: 28px; font-weight: 600; color: #135f58; }
QLabel#descriptionLabel { color: #51676a; }
QLabel#imageLabel { background: #ffffff; border: 1px solid #d5dfd5; padding: 16px; }
QLabel#propertiesLabel { color: #355451; padding: 8px; }
QPushButton#closeButton { background: #176b64; color: #ffffff; padding: 9px 20px; border: none; border-radius: 4px; }
QPushButton#closeButton:hover { background: #11544f; }
